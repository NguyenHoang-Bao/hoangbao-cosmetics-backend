# ==============================================================================
# HOÀNG BẢO COSMETICS BACKEND - ENVIRONMENT VARIABLES TEMPLATE
# Sao chép file này thành .env hoặc khai báo trên Server / Docker / Render / AWS
# ==============================================================================

# 1. Cơ sở dữ liệu MySQL
DB_URL=jdbc:mysql://localhost:3306/hoangbao_cosmetics_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# 2. Khóa bí mật JSON Web Token (JWT)
JWT_SECRET=your_jwt_secret_minimum_256_bit_base64_string
JWT_EXPIRATION_MS=86400000

# 3. Cổng thanh toán VietQR Napas247 & SePay Webhook
VIETQR_BANK_ID=MBBank
VIETQR_ACCOUNT_NUMBER=14580886868
VIETQR_ACCOUNT_NAME=NGUYEN HOANG BAO
VIETQR_TEMPLATE=compact2
SEPAY_API_KEY=your_sepay_api_key_secret_here

# 4. Xác thực Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# 5. Cấu hình gửi Mail OTP & Thông báo đơn hàng (SMTP Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_google_app_password_16_chars

# 6. Tên miền hệ thống (URL cơ sở)
APP_BACKEND_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:5173

